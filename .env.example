# Copia este archivo como ".env" y personaliza la conexión.
# Si dejas este valor, la app usará SQLite local para pruebas rápidas.
DATABASE_URL=sqlite:///local.db
# DATABASE_URL=postgresql://usuario:contraseña@ep-xxxxxxxx.region.aws.neon.tech/neondb?sslmode=require

# Web Push (la clave privada solo vive como secreto del servidor/despliegue).
# Admite el PEM de private_key.pem o DER en Base64. No agregues claves reales a Git.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
